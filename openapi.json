          },
          "llm_confidence": {
            "type": "number",
            "title": "Llm Confidence"
          },
          "grounded": {
            "type": "boolean",
            "title": "Grounded"
          },
          "evidence_span": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Evidence Span"
          },
          "reason": {
            "type": "string",
            "title": "Reason",
            "default": ""
          }
        },
        "type": "object",
        "required": [
          "field",
          "confidence",
          "llm_confidence",
          "grounded"
        ],
        "title": "FieldEvidence"
      },
      "FirstAssessment": {
        "properties": {
          "clinicalDetails": {
            "$ref": "#/components/schemas/ClinicalDetails"
          },
          "subjectiveAssessments": {
            "items": {
              "$ref": "#/components/schemas/SubjectiveAssessment"
            },
            "type": "array",
            "title": "Subjectiveassessments"
          },
          "objectiveAssessment": {
            "$ref": "#/components/schemas/ObjectiveAssessment"
          },
          "subjectiveGoals": {
            "items": {
              "$ref": "#/components/schemas/SubjectiveGoal"
            },
            "type": "array",
            "title": "Subjectivegoals"
          },
          "objectiveGoals": {
            "items": {
              "$ref": "#/components/schemas/ObjectiveGoal"
            },
            "type": "array",
            "title": "Objectivegoals"
          },
          "recommendation": {
            "items": {
              "$ref": "#/components/schemas/Recommendation"
            },
            "type": "array",
            "title": "Recommendation"
          },
          "patientAdvice": {
            "$ref": "#/components/schemas/PatientAdvice"
          }
        },
        "additionalProperties": false,
