{
  "openapi": "3.1.0",
  "info": {
    "title": "Stance Health Clinical Assessment Pipeline",
    "description": "WAV-to-structured-JSON clinical assessment form filler with deterministic grounding and confidence fusion.",
    "version": "1.0.0"
  },
  "paths": {
    "/health": {
      "get": {
        "summary": "Health",
        "operationId": "health_health_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          }
        }
      }
    },
    "/assessments/parse": {
      "post": {
        "summary": "Parse Assessment Audio",
        "description": "Parses an uploaded WAV audio file into a strict FirstAssessment JSON object.\nConfidence data and latency metrics are strictly delivered via HTTP headers.",
        "operationId": "parse_assessment_audio_assessments_parse_post",
        "requestBody": {
          "content": {
            "multipart/form-data": {
              "schema": {
                "$ref": "#/components/schemas/Body_parse_assessment_audio_assessments_parse_post"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Strict FirstAssessment JSON response body without extra keys",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/FirstAssessment"
                }
              }
            }
          },
          "400": {
            "description": "Invalid or non-WAV audio file"
          },
          "422": {
            "description": "Confidence below threshold, returning ConfidenceReport with flags",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ConfidenceReport"
                }
              }
            }
          },
          "500": {
            "description": "Transcription or LLM extraction failure"
          }
        }
      }
    },
    "/assessments": {
      "post": {
        "summary": "Save Assessment",
        "description": "Saves a validated FirstAssessment into MongoDB and returns an AssessmentRecord.",
        "operationId": "save_assessment_assessments_post",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/FirstAssessment"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AssessmentRecord"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      },
      "get": {
        "summary": "List Assessments",
        "description": "Lists saved assessments with pagination and optional date-range filtering.",
        "operationId": "list_assessments_assessments_get",
        "parameters": [
          {
            "name": "from",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "ISO datetime string start",
              "title": "From"
            },
            "description": "ISO datetime string start"
          },
          {
            "name": "to",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "ISO datetime string end",
              "title": "To"
            },
            "description": "ISO datetime string end"
          },
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "maximum": 100,
              "minimum": 1,
              "default": 20,
              "title": "Limit"
            }
          },
          {
            "name": "skip",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 0,
              "default": 0,
              "title": "Skip"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AssessmentListResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/assessments/{assessment_id}": {
      "get": {
        "summary": "Get Assessment",
        "description": "Retrieves an AssessmentRecord by ID.",
        "operationId": "get_assessment_assessments__assessment_id__get",
        "parameters": [
          {
            "name": "assessment_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Assessment Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AssessmentRecord"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "AssessmentListResponse": {
        "properties": {
          "items": {
            "items": {
              "$ref": "#/components/schemas/AssessmentRecord"
            },
            "type": "array",
            "title": "Items"
          },
          "total": {
            "type": "integer",
            "title": "Total"
          },
          "limit": {
            "type": "integer",
            "title": "Limit"
          },
          "skip": {
            "type": "integer",
            "title": "Skip"
          }
        },
        "type": "object",
        "required": [
          "items",
          "total",
          "limit",
          "skip"
        ],
        "title": "AssessmentListResponse",
        "description": "Paginated response for GET /assessments."
      },
      "AssessmentRecord": {
        "properties": {
          "id": {
            "type": "string",
            "title": "Id"
          },
          "createdAt": {
            "type": "string",
            "format": "date-time",
            "title": "Createdat"
          },
          "assessment": {
            "$ref": "#/components/schemas/FirstAssessment"
          },
          "confidence": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/ConfidenceReport"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "type": "object",
        "required": [
          "id",
          "createdAt",
          "assessment"
        ],
        "title": "AssessmentRecord",
        "description": "Returned by GET /assessments/{id} and POST /assessments: a wrapper, not the raw contract."
      },
      "Body_parse_assessment_audio_assessments_parse_post": {
        "properties": {
          "file": {
            "type": "string",
            "contentMediaType": "application/octet-stream",
            "title": "File"
          }
        },
        "type": "object",
        "required": [
          "file"
        ],
        "title": "Body_parse_assessment_audio_assessments_parse_post"
      },
      "ClinicalDetails": {
        "properties": {
          "clinicalHistory": {
            "type": "string",
            "title": "Clinicalhistory",
            "default": ""
          },
          "chiefComplaint": {
            "type": "string",
            "title": "Chiefcomplaint",
            "default": ""
          },
          "duration": {
            "type": "string",
            "title": "Duration",
