# --- Whisper (transcription) ---
# Runs locally via the open-source `openai-whisper` package - no API key
# or cost. Requires ffmpeg installed on your system.
# Options: tiny, base, small, medium, large (bigger = more accurate, slower).
WHISPER_MODEL_SIZE=base


GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL=gemini-3.5-flash-lite

MONGODB_URI=mongodb://localhost:27017
MONGODB_DB_NAME=clinical_assessments

# --- Confidence gate ---

CONFIDENCE_THRESHOLD=0.55
