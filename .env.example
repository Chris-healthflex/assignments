# ---- App ----
APP_NAME=v2n-first-assessment
ENV=local
LOG_LEVEL=INFO

# ---- MongoDB ----
# docker-compose.yml starts a local instance matching this URI
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB=v2n
MONGODB_ASSESSMENTS_COLLECTION=first_assessments

# ---- Whisper (transcription) ----
# Backend: "local" (faster-whisper / openai-whisper) or "api"
WHISPER_BACKEND=local
WHISPER_MODEL=base
WHISPER_DEVICE=cpu
WHISPER_LANGUAGE=en

# ---- LLM (extraction agent) ----
ANTHROPIC_API_KEY=
EXTRACTION_MODEL=claude-opus-5
EXTRACTION_MAX_RETRIES=2
