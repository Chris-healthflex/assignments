GROQ_API_KEY=gsk_...
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
MONGO_DB_NAME=stance_health
# Number of top-level FirstAssessment sections (out of 7) the extraction
# agent may mark low-confidence before /assessments/parse returns 422 instead
# of 200. Real sessions often don't cover every section (e.g. goals, advice),
# so this is set high enough to only trip on broad extraction failure.
CONFIDENCE_FLAG_THRESHOLD=5
