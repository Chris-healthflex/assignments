# --- LLM ---
# Provider: openai | google | groq
LLM_PROVIDER=google
# Leave LLM_MODEL blank to use the provider default
# (openai=gpt-4o-mini, google=gemini-3.6-flash, groq=llama-3.3-70b-versatile)
LLM_MODEL=
LLM_TEMPERATURE=0.0

# Only the key for your chosen provider is required.
OPENAI_API_KEY=
GOOGLE_API_KEY=
GROQ_API_KEY=

# --- Whisper ---
WHISPER_MODEL=base.en
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8

# --- MongoDB ---
MONGODB_URI=mongodb://localhost:27017
DATABASE_NAME=stance_health
ASSESSMENTS_COLLECTION=assessments

# --- Extraction quality gate ---
CONFIDENCE_THRESHOLD=0.70

# --- Upload guard (bytes) ---
MAX_UPLOAD_BYTES=52428800
