MONGO_URI=mongodb://localhost:27017
MONGO_DB_NAME=stance_health
MONGO_COLLECTION=assessments

WHISPER_MODEL=base
WHISPER_DEVICE=cpu

# Local Ollama server — no API key needed, no cost, runs fully offline.
OLLAMA_BASE_URL=http://localhost:11434
# Must support tool-calling in Ollama: llama3.1:8b, qwen2.5:7b, mistral-nemo, etc.
EXTRACTION_MODEL=llama3.1:8b

MIN_FIELD_CONFIDENCE=0.55
MIN_OVERALL_CONFIDENCE=0.6

UPLOAD_DIR=./data/uploads
