# MongoDB
MONGODB_URL=mongodb://localhost:27017
DATABASE_NAME=stance_health
COLLECTION_NAME=assessments

# Pipeline Settings
CONFIDENCE_THRESHOLD=0.70
WHISPER_MODEL=base

# LLM Selection: gemini | openai | anthropic | ollama
LLM_PROVIDER=gemini

# Provider Keys (set the key for your selected provider)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-haiku-20240307

OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3

# Server
API_HOST=0.0.0.0
API_PORT=8000
