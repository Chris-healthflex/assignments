# ---- LLM used by the LangGraph extraction agent ----
LLM_PROVIDER=google            # openai | anthropic | google
LLM_MODEL=gemini-2.5-flash     # gpt-4o-mini | claude-sonnet-5 | gemini-2.5-flash
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=

# ---- Whisper transcription ----
WHISPER_BACKEND=local          # local (openai-whisper) | api (OpenAI whisper-1)
WHISPER_MODEL=medium           # tiny | base | small | medium | large  (local only)
# WHISPER_INITIAL_PROMPT=      # optional: override the built-in clinical vocabulary prime

# ---- MongoDB ----
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB=stance_assessments

# ---- Extraction guardrails ----
CONFIDENCE_THRESHOLD=0.5       # /assessments/parse returns 422 if any core field is below this
