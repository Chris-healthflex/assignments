APP_NAME="Stance Health Clinical Assessment API"
APP_VERSION="1.0.0"

# MongoDB Database Configuration
MONGODB_URI="mongodb://localhost:27017"
MONGODB_DATABASE="stance_assessment"

# Audio & Whisper Configuration
WHISPER_BACKEND="local"
WHISPER_MODEL="base"
WHISPER_LANGUAGE="en"
MAX_AUDIO_SIZE_MB=100

# Extraction & Anti-Hallucination Guardrails
CONFIDENCE_THRESHOLD=0.70

# LLM Providers (Optional for cloud LLMs; fallback heuristic extractor is built-in)
LLM_PROVIDER="auto"
OPENAI_API_KEY=""
GOOGLE_API_KEY=""
ANTHROPIC_API_KEY=""
OLLAMA_BASE_URL="http://localhost:11434"
OLLAMA_MODEL="llama3.2:3b"
