# Copy to .env and fill in your own values. Never commit the real .env file.

# Required. Used by the LangGraph extraction workflow.
GOOGLE_API_KEY=your-google-api-key

# Transcription: "local" runs openai-whisper on this machine, "openai" uses the
# OpenAI transcription API and needs OPENAI_API_KEY.
WHISPER_BACKEND=local
WHISPER_MODEL=small
WHISPER_LANGUAGE=en
OPENAI_API_KEY=

# Extraction
LLM_MODEL=gemini-2.5-flash
EXTRACTION_CONFIDENCE_THRESHOLD=0.6

# MongoDB
MONGODB_URI=mongodb://localhost:27017
MONGODB_DATABASE=clinical
MONGODB_COLLECTION=assessments

MAX_UPLOAD_BYTES=52428800
LOG_LEVEL=INFO
