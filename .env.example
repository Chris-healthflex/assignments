MONGO_URI=mongodb://localhost:27017
MONGO_DB_NAME=stance_health
MONGO_COLLECTION=assessments

WHISPER_MODEL=base
WHISPER_DEVICE=cpu

# Local Ollama server — no API key required.
OLLAMA_BASE_URL=http://localhost:11434
# Qwen2.5 7B is used for local structured clinical extraction.
EXTRACTION_MODEL=qwen2.5:7b

MIN_FIELD_CONFIDENCE=0.55
MIN_OVERALL_CONFIDENCE=0.6

UPLOAD_DIR=./data/uploads
