# ---- App ----
APP_NAME=v2n-first-assessment
ENV=local
LOG_LEVEL=INFO
# Largest audio upload accepted, in megabytes. ~2 hours of 16-bit mono WAV.
MAX_UPLOAD_MB=50

# ---- MongoDB ----
# Atlas: paste the driver connection string, which looks like
#   mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
# URL-encode the password if it contains @ : / or ?.
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB=v2n
MONGODB_ASSESSMENTS_COLLECTION=first_assessments
# How long to wait for a server before giving up. Short on purpose: a paused
# Atlas cluster should fail the request, not hang the worker for 30s.
MONGODB_TIMEOUT_MS=5000

# ---- Whisper (transcription) ----
# Backend: "local" (faster-whisper / openai-whisper) or "api"
WHISPER_BACKEND=local
WHISPER_MODEL=small
WHISPER_DEVICE=cpu
WHISPER_LANGUAGE=en

# ---- LLM (extraction agent) ----
# Get a free key at https://aistudio.google.com/apikey
GOOGLE_API_KEY=
EXTRACTION_MODEL=gemini-3.1-flash-lite
# Keep at 0.0: extraction must be reproducible, and sampling invents detail.
EXTRACTION_TEMPERATURE=0.0
EXTRACTION_MAX_RETRIES=2
# Fields scoring below this are returned as 422 detail instead of silently.
EXTRACTION_CONFIDENCE_THRESHOLD=0.6

# Free-tier Gemini allows 5 requests per minute. The agent makes 3 calls per
# extraction (subjective / objective / plan), plus up to 2 repair calls, so
# without client-side pacing the fan-out 429s. Raise if you are on a paid key.
EXTRACTION_REQUESTS_PER_MINUTE=4
