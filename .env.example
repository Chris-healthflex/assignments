# ==========================================
# Clinical Assessment Pipeline Configuration
# ==========================================

# Server Configuration
HOST=0.0.0.0
PORT=8000
ENVIRONMENT=development
DEBUG=true

# MongoDB Configuration
MONGODB_URI=mongodb://localhost:27017
MONGODB_DATABASE=clinical_assessments
MONGODB_COLLECTION=assessments

# LLM Configuration (Supports Groq Cloud, OpenAI Direct, etc.)
# Option 1: Groq Cloud (Fast inference for Whisper & GPT-OSS)
GROQ_API_KEY=your_groq_api_key_here
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=openai/gpt-oss-120b
LLM_TEMPERATURE=0.0

# Option 2: OpenAI Direct
# OPENAI_API_KEY=your_openai_api_key_here
# LLM_MODEL=gpt-4o-mini
# LLM_TEMPERATURE=0.0

# Whisper Configuration
# WHISPER_MODE: "openai" (uses cloud Whisper API via OpenAI or Groq) or "local" or "mock"
WHISPER_MODE=openai
WHISPER_MODEL=whisper-large-v3-turbo
LOCAL_WHISPER_MODEL=base

# Extraction & Anti-Hallucination Configuration
CONFIDENCE_THRESHOLD=0.70
MAX_AUDIO_SIZE_BYTES=52428800 # 50 MB
ALLOWED_AUDIO_EXTENSIONS=.wav
