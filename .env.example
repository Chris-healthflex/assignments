# Copy to .env and adjust. .env is gitignored; this file is committed.

# ---- Transcription ---------------------------------------------------------
# faster  = faster-whisper / CTranslate2 (default; no torch, no ffmpeg)
# openai  = the literal openai-whisper package (pip install -r requirements-optional.txt)
WHISPER_BACKEND=faster
WHISPER_MODEL=small           # tiny | base | small | medium | large-v3
WHISPER_DEVICE=cpu            # keep on CPU: the GPU's 4 GB is reserved for the LLM
WHISPER_COMPUTE_TYPE=int8
WHISPER_LANGUAGE=en           # blank => auto-detect

# ---- Extraction agent ------------------------------------------------------
LLM_PROVIDER=ollama           # ollama | anthropic | openai
# Must fit entirely in 4 GB VRAM. Larger models trigger Ollama's hybrid
# GPU/CPU offload, which crashes on this GTX 1650. Do not raise without testing.
LLM_MODEL=qwen2.5:3b-instruct
LLM_TEMPERATURE=0.0
OLLAMA_BASE_URL=http://localhost:11434
# ANTHROPIC_API_KEY=sk-ant-...
# OPENAI_API_KEY=sk-...

# ---- Confidence gate -------------------------------------------------------
# Below this overall score, POST /assessments/parse returns 422 with
# field-level detail instead of a half-empty assessment.
CONFIDENCE_THRESHOLD=0.55

# ---- MongoDB ---------------------------------------------------------------
# Local portable server: powershell -ExecutionPolicy Bypass -File C:\Users\sebin\mongodb\start-mongo.ps1
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB=clinical_assessments
MONGODB_COLLECTION=first_assessments
