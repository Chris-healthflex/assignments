# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Env / secrets
.env
.env.local

# Model weights and the transcript cache
models/
.cache/

# Frontend build inputs. The built bundle in app/static IS committed, so the
# service runs from a clone with no npm install; the tree that produces it is
# not.
frontend/node_modules/
frontend/.vite/

# Editors / OS
.vscode/
.idea/
.DS_Store
Thumbs.db

# The recording. The brief supplies clinical_assessment.wav as an input file
# and asks for code, tests and a README back, so the audio is not part of what
# is submitted. It is also a real patient consultation, which does not belong
# in a shared repository. Extensions match what the upload endpoint accepts, so
# a recording in any supported format is covered.
*.wav
*.wave
*.mp3
*.m4a
*.flac
*.ogg
*.webm
audio/

# Derived transcripts and captured API responses. Both embed the transcript,
# which is patient audio in text form. Never commit either.
transcript.txt
last_api_response.json
*assessment*.json
*.log
